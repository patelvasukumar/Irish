# Copy this file to .env and fill in what you need. .env is NEVER committed.

# ---- C2 Text generation: ollama | groq | gemini | stub ----
LLM_PROVIDER=ollama
LLM_FALLBACK_TO_STUB=true

# Ollama (free, local): install https://ollama.com then `ollama pull llama3.2`
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- C3 OCR (Windows example) ----
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- C4 Neo4j (later) ----
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- C5 PostgreSQL (empty = local JSON file). e.g. postgresql://postgres:PASSWORD@localhost:5432/irish ----
DATABASE_URL=

# ---- C7 Mailbox, read-only (use an app password) ----
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# ---- Google Cloud Storage (optional) ----
GCS_BUCKET=

CORS_ORIGINS=*
